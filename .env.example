# Supabase project URL (e.g. https://<project-ref>.supabase.co)
SUPABASE_URL=

# Supabase anonymous/public key
SUPABASE_ANON_KEY=

# Supabase service role key (keep secret — never expose to clients)
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter API key — required only for the llm-inference-openai function
OPENROUTER_API_KEY=

# Optional: HTTP-Referer header forwarded to OpenRouter
OPENROUTER_REFERER=

# Optional: X-OpenRouter-Title header forwarded to OpenRouter
OPENROUTER_TITLE=
